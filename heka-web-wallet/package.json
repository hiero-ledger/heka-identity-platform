{
  "name": "heka-web-wallet",
  "version": "0.1.0",
  "description": "Heka Web Wallet: receive, store and present verifiable credentials (SD-JWT VC) over OpenID4VC",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && yarn check:dist",
    "build:dev": "vite build --mode development",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:dist": "yarn check:content-scripts && yarn check:workarounds && yarn check:csp && yarn check:manifest",
    "check:content-scripts": "node scripts/check-content-scripts.mjs",
    "check:workarounds": "node scripts/check-build-workarounds.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "engines": {
    "node": "^20.19.2 || ^22.13.0"
  },
  "dependencies": {
    "@credo-ts/core": "0.7.4",
    "@credo-ts/openid4vc": "0.7.4",
    "@hiero-did-sdk/resolver": "0.1.8",
    "@noble/hashes": "2.4.0",
    "events": "^3.3.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.6.0",
    "jose": "6.2.17",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "caniuse-lite": "1.0.30001819",
    "electron-to-chromium": "1.5.464",
    "encodeurl": "2.0.0",
    "node-releases": "2.0.60",
    "qs": "6.16.1",
    "rollup": "4.65.0",
    "strip-ansi@npm:7.1.2/ansi-regex": "6.4.0"
  },
  "packageManager": "yarn@4.16.0"
}
