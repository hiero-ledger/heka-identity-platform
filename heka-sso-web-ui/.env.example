# Which auth stack the app uses: keycloak (default) or auth0
VITE_AUTH_PROVIDER=keycloak

# Keycloak (VITE_AUTH_PROVIDER=keycloak)
VITE_KC_URL=http://localhost:8080
VITE_KC_REALM=heka
VITE_KC_CLIENT_ID=heka-sso-web-ui

# Auth0 (VITE_AUTH_PROVIDER=auth0)
VITE_AUTH0_DOMAIN=<tenant>.<region>.auth0.com
VITE_AUTH0_CLIENT_ID=<Auth0 SPA application client id>
# Optional: forward straight to this enterprise connection (analog of kc_idp_hint)
VITE_AUTH0_CONNECTION=heka-sso
