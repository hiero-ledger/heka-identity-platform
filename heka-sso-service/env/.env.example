APP_VERSION=0.0.1
APP_PORT=3005
APP_ENABLE_CORS=true

LOG_LEVEL=trace
LOG_EXCLUDE_URLS=/version,/health

DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=heka-sso-service
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

OIDC_ISSUER_URL=<ISSUER_URL>
# Dev-only secrets: the service refuses these values in production (fail-fast)
OIDC_COOKIE_KEYS=dev-only-cookie-key-do-not-use-in-production
OIDC_SUB_HMAC_SALT=dev-only-sub-hmac-salt-do-not-use-in-production

IDENTITY_SERVICE_BASE_URL=<IDENTITY_SERVICE_BASE_URL>
# Identity-service service account: the bridge logs into
# heka-auth-service itself and re-acquires the token before it expires.
# The demo user is created by heka-identity-service-web-ui's prepare-demo-user script.
AUTH_SERVICE_BASE_URL=<AUTH_SERVICE_BASE_URL>
IDENTITY_SERVICE_AUTH_NAME=<IDENTITY_SERVICE_AUTH_NAME>
IDENTITY_SERVICE_AUTH_PASSWORD=<IDENTITY_SERVICE_AUTH_PASSWORD>
# Static token override for tests/dev (bypasses the service-account login;
# heka-auth-service access tokens expire after ~1h):
# IDENTITY_SERVICE_AUTH_TOKEN=
# Wallet login: the identity-service verifier the bridge creates sessions
# under, and the DID that signs authorization requests (JAR, required,
# no unsigned fallback). Set both to enable the wallet path.
IDENTITY_SERVICE_PUBLIC_VERIFIER_ID=<IDENTITY_SERVICE_PUBLIC_VERIFIER_ID>
IDENTITY_SERVICE_REQUEST_SIGNER_DID=<IDENTITY_SERVICE_REQUEST_SIGNER_DID>

# Signing JWKS is generated on first start and persisted in Postgres.
# Dev/test override (never commit real keys):
# OIDC_JWKS={"keys":[...]}
# OIDC_JWKS_FILE=./env/jwks.json

# JSON values may span lines: wrap them in SINGLE quotes (dotenv multi-line syntax;
# double quotes would end at the first inner " of the JSON). Whitespace is fine for JSON.parse.
OIDC_CLIENTS='[
  {
    "clientId": "keycloak-broker",
    "clientSecret": "dev-only-broker-secret-do-not-use-in-production",
    "redirectUris": [
      "<KEYCLOAK_BASE_URL>/realms/heka/broker/heka-sso/endpoint",
      "<KEYCLOAK_BASE_URL>/realms/master/broker/heka-sso/endpoint"
    ],
    "postLogoutRedirectUris": [
      "<KEYCLOAK_BASE_URL>/realms/heka/broker/heka-sso/endpoint/logout_response",
      "<KEYCLOAK_BASE_URL>/realms/master/broker/heka-sso/endpoint/logout_response"
    ],
    "backchannelLogoutUri": "<KEYCLOAK_BASE_URL>/realms/heka/protocol/openid-connect/logout/backchannel-logout",
    "loginConfigId": "default"
  },
  {
    "clientId": "auth0-broker",
    "clientSecret": "dev-only-broker-secret-do-not-use-in-production",
    "redirectUris": [
      "<AUTH0_BASE_URL>/login/callback"
    ],
    "postLogoutRedirectUris": [
      "<AUTH0_BASE_URL>/logout"
    ],
    "loginConfigId": "default"
  }
]'
OIDC_LOGIN_CONFIGS='[
  {
    "id": "default",
    "verificationTemplate": "default",
    "dcqlQuery": {
      "credentials": [
        {
          "id": "mdl",
          "format": "dc+sd-jwt",
          "meta": {
            "vct_values": [
              "mDL"
            ]
          },
          "claims": [
            {
              "path": [
                "given_name"
              ]
            },
            {
              "path": [
                "family_name"
              ]
            },
            {
              "path": [
                "age_over_18"
              ]
            }
          ]
        }
      ]
    },
    "claimMapping": {
      "mdl.given_name": "given_name",
      "mdl.family_name": "family_name",
      "mdl.age_over_18": "age_over_18"
    },
    "subStrategy": "derived",
    "issuerAllowlist": []
  }
]'

# Dev-only stub login: completes the wallet-login
# interaction immediately without credential verification. Refused in production.
OIDC_STUB_LOGIN=false

# Dev-only: allow back-channel logout POSTs to reach the dev Keycloak on
# localhost:8080 - the provider's SSRF protection otherwise blocks special-use
# IPs. Refused in production.
OIDC_ALLOW_PRIVATE_NETWORK_CALLS=true

# skip the logout confirmation dialog when the request carries a valid
# id_token_hint (the broker chain - the user already confirmed at the IdP).
# Default: false - the dialog is always shown.
# OIDC_LOGOUT_AUTO_CONFIRM=true

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
