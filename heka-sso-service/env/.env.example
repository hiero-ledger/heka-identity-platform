APP_VERSION=0.0.1
APP_PORT=3005
APP_ENABLE_CORS=true

LOG_LEVEL=trace
LOG_EXCLUDE_URLS=/version,/health

DB_HOST=localhost
DB_PORT=5434
DB_NAME=heka-sso-service
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

OIDC_ISSUER_URL=http://localhost:3005
# Dev-only secrets: the service refuses these values in production (fail-fast)
OIDC_COOKIE_KEYS=dev-only-cookie-key-do-not-use-in-production
OIDC_SUB_HMAC_SALT=dev-only-sub-hmac-salt-do-not-use-in-production

IDENTITY_SERVICE_BASE_URL=http://localhost:3000
# Identity-service service account (P1.6.7): the bridge logs into
# heka-auth-service itself and re-acquires the token before it expires.
# The demo user is created by heka-identity-service-web-ui's prepare-demo-user script.
AUTH_SERVICE_BASE_URL=http://localhost:3004
IDENTITY_SERVICE_AUTH_NAME=<IDENTITY_SERVICE_AUTH_NAME>
IDENTITY_SERVICE_AUTH_PASSWORD=<IDENTITY_SERVICE_AUTH_PASSWORD>
# Static token override for tests/dev (bypasses the service-account login;
# heka-auth-service access tokens expire after ~1h):
# IDENTITY_SERVICE_AUTH_TOKEN=
# Wallet login (P1.6): the identity-service verifier the bridge creates sessions
# under, and the DID that signs authorization requests (JAR, P1.6.1 — required,
# no unsigned fallback). Set both to enable the wallet path.
IDENTITY_SERVICE_PUBLIC_VERIFIER_ID=did:key:z6MkkGdVkGSPG7V5K3TxejbGNaMshUJ2ydvx8Uueqf5zGjsv
IDENTITY_SERVICE_REQUEST_SIGNER_DID=did:key:z6MkkGdVkGSPG7V5K3TxejbGNaMshUJ2ydvx8Uueqf5zGjsv

# Signing JWKS is generated on first start and persisted in Postgres.
# Dev/test override (never commit real keys):
# OIDC_JWKS={"keys":[...]}
# OIDC_JWKS_FILE=./env/jwks.json

OIDC_CLIENTS=[{"clientId":"keycloak-broker","clientSecret":"dev-only-broker-secret-do-not-use-in-production","redirectUris":["http://localhost:8080/realms/heka/broker/heka-sso/endpoint","http://localhost:8080/realms/master/broker/heka-sso/endpoint"],"postLogoutRedirectUris":["http://localhost:8080/realms/heka/broker/heka-sso/endpoint/logout_response","http://localhost:8080/realms/master/broker/heka-sso/endpoint/logout_response"],"loginConfigId":"default"}]
OIDC_LOGIN_CONFIGS=[{"id":"default","verificationTemplate":"default","dcqlQuery":{"credentials":[{"id":"mdl","format":"dc+sd-jwt","meta":{"vct_values":["mDL"]},"claims":[{"path":["given_name"]},{"path":["family_name"]},{"path":["age_over_18"]}]}]},"claimMapping":{"mdl.given_name":"given_name","mdl.family_name":"family_name","mdl.age_over_18":"age_over_18"},"subStrategy":"derived","issuerAllowlist":[]}]

# Dev-only stub login (INTEGRATION.md P1.3): completes the wallet-login
# interaction immediately without credential verification. Refused in production.
OIDC_STUB_LOGIN=false

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
