# Deployment mode: unset counts as production, which refuses the dev-only secrets below and OIDC_ALLOW_PRIVATE_NETWORK_CALLS=true.
NODE_ENV=development

APP_VERSION=0.0.1
APP_PORT=3005
APP_ENABLE_CORS=true

LOG_LEVEL=trace
LOG_EXCLUDE_URLS=/version,/health

DB_HOST=<DB_HOST, e.g. localhost>
DB_PORT=<DB_PORT, e.g. 5434 (docker-compose Postgres)>
DB_NAME=heka-sso-service
DB_USER=<DB_USER, e.g. heka>
DB_PASSWORD=<DB_PASSWORD, e.g. heka1>

OIDC_ISSUER_URL=http://localhost:3005
# Dev-only secrets: the service refuses these values in production
OIDC_COOKIE_KEYS=dev-only-cookie-key-do-not-use-in-production
OIDC_SUB_HMAC_SALT=dev-only-sub-hmac-salt-do-not-use-in-production

IDENTITY_SERVICE_BASE_URL=http://localhost:3000

# Keycloak
IDENTITY_SERVICE_TOKEN_URL=<TOKEN_ENDPOINT, e.g. <KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/heka-platform/protocol/openid-connect/token>
IDENTITY_SERVICE_CLIENT_ID=heka-sso-service
IDENTITY_SERVICE_CLIENT_SECRET=dev-only-heka-sso-service-secret-do-not-use-in-production

# Auth0
# IDENTITY_SERVICE_TOKEN_URL=https://<tenant>.<region>.auth0.com>/oauth/token
# IDENTITY_SERVICE_CLIENT_ID=<CLIENT_ID>
# IDENTITY_SERVICE_CLIENT_SECRET=<CLIENT_SECRET>
# IDENTITY_SERVICE_TOKEN_PARAMS={"audience":"https://heka-identity"}
# IDENTITY_SERVICE_CLIENT_AUTH_METHOD=client_secret_post
# IDENTITY_SERVICE_AUTH_TOKEN=

# Wallet login: the identity-service verifier the bridge creates sessions
# under, and the DID that signs authorization requests.
IDENTITY_SERVICE_PUBLIC_VERIFIER_ID=<VERIFIER_ID>
IDENTITY_SERVICE_REQUEST_SIGNER_DID=<SIGNER_DID>

# Signing JWKS is generated on first start and persisted in Postgres.
# Dev/test override (never commit real keys):
# OIDC_JWKS={"keys":[...]}
# OIDC_JWKS_FILE=./env/jwks.json

# Both arrays below can come from JSON files instead (read only when the inline value is unset):
# OIDC_CLIENTS_FILE=./env/oidc-clients.json            copy env/oidc-clients.example.json, gitignored
# OIDC_LOGIN_CONFIGS_FILE=./env/oidc-login-configs.json

OIDC_CLIENTS='[
  {
    "clientId": "keycloak-broker",
    "clientSecret": "dev-only-broker-secret-do-not-use-in-production",
    "redirectUris": [
      "<KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/heka/broker/heka-sso/endpoint",
      "<KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/master/broker/heka-sso/endpoint"
    ],
    "postLogoutRedirectUris": [
      "<KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/heka/broker/heka-sso/endpoint/logout_response",
      "<KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/master/broker/heka-sso/endpoint/logout_response"
    ],
    "backchannelLogoutUri": "<KEYCLOAK_BASE_URL, e.g. http://localhost:8080>/realms/heka/protocol/openid-connect/logout/backchannel-logout",
    "loginConfigId": "default"
  },
  {
    "clientId": "auth0-broker",
    "clientSecret": "dev-only-broker-secret-do-not-use-in-production",
    "redirectUris": [
      "<AUTH0_BASE_URL, e.g. https://<tenant>.<region>.auth0.com>/login/callback"
    ],
    "postLogoutRedirectUris": [
      "<AUTH0_BASE_URL, e.g. https://<tenant>.<region>.auth0.com>/logout"
    ],
    "loginConfigId": "default"
  }
]'

OIDC_LOGIN_CONFIGS='[
  {
    "id": "default",
    "verificationTemplate": "default",
    "dcqlQuery": {
      "credentials": [
        {
          "id": "mdl",
          "format": "dc+sd-jwt",
          "meta": {
            "vct_values": [
              "mDL"
            ]
          },
          "claims": [
            {
              "path": [
                "given_name"
              ]
            },
            {
              "path": [
                "family_name"
              ]
            },
            {
              "path": [
                "age_over_18"
              ]
            }
          ]
        }
      ]
    },
    "claimMapping": {
      "mdl.given_name": "given_name",
      "mdl.family_name": "family_name",
      "mdl.age_over_18": "age_over_18"
    },
    "subStrategy": "derived",
    "issuerAllowlist": []
  }
]'

# Dev-only stub login: completes the wallet-login interaction immediately without credential verification.
OIDC_STUB_LOGIN=false

# Dev-only: allow back-channel logout POSTs to reach the dev Keycloak on
# localhost:8080 - the provider's SSRF protection otherwise blocks special-use IPs.
OIDC_ALLOW_PRIVATE_NETWORK_CALLS=true

# skip the logout confirmation dialog when the request carries a valid
# id_token_hint (the broker chain - the user already confirmed at the IdP).
# Default: false - the dialog is always shown.
# OIDC_LOGOUT_AUTO_CONFIRM=true

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
