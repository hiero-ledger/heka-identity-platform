{
  "name": "heka-keycloak-theme",
  "version": "0.0.0",
  "description": "Light Keycloakify login theme for the OID4VP SSO Demo realm",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "storybook": "storybook dev -p 6006",
    "format": "prettier --write \"**/*.{ts,tsx,html,less,scss,json,css,js}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,html,less,scss,json,css,js}\"",
    "lint": "eslint --fix",
    "lint-check": "eslint"
  },
  "license": "MIT",
  "keywords": [],
  "dependencies": {
    "keycloakify": "11.16.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@storybook/react": "8.1.10",
    "@storybook/react-vite": "8.1.10",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.2.1",
    "eslint": "9.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "eslint-plugin-storybook": "0.11.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "15.12.0",
    "prettier": "3.3.1",
    "storybook": "8.1.10",
    "typescript": "5.2.2",
    "typescript-eslint": "8.15.0",
    "vite": "5.0.8"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "private": true,
  "packageManager": "yarn@4.16.0"
}
