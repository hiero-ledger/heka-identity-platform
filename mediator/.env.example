# Public endpoints of the mediator, comma separated (HTTP and WebSocket share the same port).
# Must be reachable from the mobile device, e.g. http://192.168.1.10:3110,ws://192.168.1.10:3110
# or a tunnel / public domain: https://mediator.example.com,wss://mediator.example.com
AGENT_ENDPOINTS=http://localhost:3110,ws://localhost:3110

# Host port the mediator is exposed on
MEDIATOR_PORT=3110

AGENT_NAME=Heka DIDComm Mediator
LOG_LEVEL=info

# WARNING: the default ASKAR_STORE_KEY and POSTGRES_PASSWORD below are public and for local development only.
# Before exposing the mediator through a tunnel or a public domain, replace both with random values,
# e.g. `openssl rand -base64 32`. Set them before the first start: changing ASKAR_STORE_KEY later
# requires removing the Postgres volume (`docker compose down -v`), which creates a new mediator identity.

# Askar store (agent keys and records). Changing these values creates a new mediator identity.
ASKAR_STORE_ID=mediator
ASKAR_STORE_KEY=mediator

POSTGRES_USER=mediator
POSTGRES_PASSWORD=mediator

# Mediator image tag (upstream publishes commit-based tags only)
MEDIATOR_IMAGE_TAG=375518d
