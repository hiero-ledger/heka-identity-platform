# Copy to docker/mediator/.env (gitignored). Dev only — never commit the filled-in file.

# Public endpoints of the mediator, as the phone sees them: this PC's LAN IP (same Wi-Fi as the phone).
# Find it with `ipconfig` (Windows) or `ip addr` (Linux); allow inbound TCP 3110 in the firewall.
AGENT_ENDPOINTS=http://<PC_LAN_IP>:3110,ws://<PC_LAN_IP>:3110
AGENT_NAME=Heka Dev Mediator
LOG_LEVEL=debug

# Askar wallet of the mediator (SQLite in the mediator-data volume). Generate your own key, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ASKAR__STORE_ID=heka-mediator
ASKAR__STORE_KEY=<generate>

# Firebase service account of YOUR Firebase project (the one heka-wallet's google-services.json comes from):
# Firebase console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from that JSON; keep the \n escapes in the key, one line.
PUSH_NOTIFICATIONS__FIREBASE__PROJECTS=[{"projectId":"<project_id>","clientEmail":"<client_email>","privateKey":"<private_key>"}]
PUSH_NOTIFICATIONS__FIREBASE__NOTIFICATION_TITLE=Heka Wallet
PUSH_NOTIFICATIONS__FIREBASE__NOTIFICATION_BODY=You have a new message
