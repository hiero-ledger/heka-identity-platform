## Public endpoints of heka-identity-service for a phone wallet (an https tunnel, e.g. ngrok).
## Leave them empty for a desktop-only run: the service then advertises http://localhost:<port>.
## Each one is its own listener; a free ngrok account exposes one port, see the nginx recipe in
## heka-identity-service/docs/local-config-for-heka-wallet-integration.md.
# OID4VC router (:3003): credential offers, presentation requests and uploaded logos.
# e.g. https://abc123.ngrok-free.app (tunnel to 3003)
IDENTITY_SERVICE_AGENT_OID4VCI_ENDPOINT=
# Wallet-facing base URL for logos: the same tunnel to 3003. Empty = FILE_STORAGE_FS_URL.
IDENTITY_SERVICE_FILE_STORAGE_FS_PUBLIC_URL=
# DIDComm, only for DIDComm flows with a remote wallet: :3001 over https, :3002 over wss.
# e.g. https://def456.ngrok-free.app (tunnel to 3001), wss://ghi789.ngrok-free.app (tunnel to 3002)
IDENTITY_SERVICE_AGENT_HTTP_ENDPOINT=
IDENTITY_SERVICE_AGENT_WS_ENDPOINT=
# REST API (:3000) base URL embedded into status-list credential URLs and revocation tails URLs,
# only when wallets or verifiers resolve them remotely. e.g. https://jkl012.ngrok-free.app (tunnel to 3000)
IDENTITY_SERVICE_APP_ENDPOINT=

IDENTITY_SERVICE_FILE_STORAGE_FS_URL=http://localhost:3000
IDENTITY_SERVICE_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false
IDENTITY_SERVICE_WEBHOOK_ALLOW_HTTP=false
IDENTITY_SERVICE_ROLE_MODEL_ENABLED=false

# Written by docker/prepare-sso-verifier.ps1
SSO_SERVICE_IDENTITY_SERVICE_PUBLIC_VERIFIER_ID=
SSO_SERVICE_IDENTITY_SERVICE_REQUEST_SIGNER_DID=

SSO_SERVICE_OIDC_STUB_LOGIN=false
SSO_SERVICE_LOG_LEVEL=info

# Demo pages of the identity web UI: the demo account's DID, printed by `yarn prepare-demo-user`
# in heka-identity-service-web-ui once the stack is up (README, Getting Started step 9).
# Baked into the web UI image: rebuild heka-identity-web-ui after setting it.
IDENTITY_WEBUI_DEMO_USER_DID=
KC_HOSTNAME=http://localhost:8080

# Keycloak
IDENTITY_WEBUI_AUTH_PROVIDER=keycloak
IDENTITY_WEBUI_OIDC_AUTHORITY=http://localhost:8080/realms/heka-platform
IDENTITY_WEBUI_OIDC_CLIENT_ID=heka-identity-web-ui
IDENTITY_WEBUI_OIDC_AUDIENCE=

IDENTITY_SERVICE_OIDC_ISSUER_URL=http://localhost:8080/realms/heka-platform
IDENTITY_SERVICE_OIDC_JWKS_URI=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/certs
IDENTITY_SERVICE_OIDC_AUDIENCE=heka-identity-service
IDENTITY_SERVICE_OIDC_CLAIM_USER_ID=
IDENTITY_SERVICE_OIDC_CLAIM_ROLES=
IDENTITY_SERVICE_OIDC_CLAIM_NAME=
IDENTITY_SERVICE_OIDC_CLAIM_ORG_ID=heka_organization,org_id
IDENTITY_SERVICE_OIDC_CLAIM_ORG_ID_FIELD=heka_org_id
IDENTITY_SERVICE_DEMO_TOKEN_URL=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/token
IDENTITY_SERVICE_DEMO_CLIENT_ID=heka-demo
IDENTITY_SERVICE_DEMO_CLIENT_SECRET=dev-only-heka-demo-secret-do-not-use-in-production
IDENTITY_SERVICE_DEMO_TOKEN_PARAMS=

SSO_SERVICE_IDENTITY_SERVICE_TOKEN_URL=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/token
SSO_SERVICE_IDENTITY_SERVICE_CLIENT_ID=heka-sso-service
SSO_SERVICE_IDENTITY_SERVICE_CLIENT_SECRET=dev-only-heka-sso-service-secret-do-not-use-in-production
SSO_SERVICE_IDENTITY_SERVICE_TOKEN_PARAMS=
SSO_SERVICE_OIDC_ISSUER_URL=http://localhost:3005

VITE_SSO_WEBUI_AUTH_PROVIDER=keycloak
VITE_SSO_WEBUI_KC_URL=http://localhost:8080
VITE_SSO_WEBUI_KC_REALM=heka
VITE_SSO_WEBUI_KC_CLIENT_ID=heka-sso-web-ui
VITE_SSO_WEBUI_KC_IDP_HINT=heka-sso

# Auth0
# IDENTITY_WEBUI_AUTH_PROVIDER=auth0
# IDENTITY_WEBUI_OIDC_AUTHORITY=https://<tenant>.<region>.auth0.com/
# IDENTITY_WEBUI_OIDC_CLIENT_ID=<heka-identity-web-ui SPA client id>
# IDENTITY_WEBUI_OIDC_AUDIENCE=https://heka-identity
# Optional: Auth0 organization (id or name) to sign in to
# IDENTITY_WEBUI_OIDC_ORGANIZATION=

# IDENTITY_SERVICE_OIDC_ISSUER_URL=https://<tenant>.<region>.auth0.com/
# IDENTITY_SERVICE_OIDC_JWKS_URI=
# IDENTITY_SERVICE_OIDC_AUDIENCE=https://heka-identity
# IDENTITY_SERVICE_OIDC_CLAIM_USER_ID=https://heka/heka_uid
# IDENTITY_SERVICE_OIDC_CLAIM_ROLES=https://heka/roles
# IDENTITY_SERVICE_OIDC_CLAIM_NAME=https://heka/name,name,nickname
# IDENTITY_SERVICE_OIDC_CLAIM_ORG_ID=https://heka/org_id
# IDENTITY_SERVICE_OIDC_CLAIM_ORG_ID_FIELD=
# IDENTITY_SERVICE_DEMO_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# IDENTITY_SERVICE_DEMO_CLIENT_ID=<heka-demo M2M client id>
# IDENTITY_SERVICE_DEMO_CLIENT_SECRET=<heka-demo M2M client secret>
# IDENTITY_SERVICE_DEMO_TOKEN_PARAMS={"audience":"https://heka-identity"}

# SSO_SERVICE_IDENTITY_SERVICE_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# SSO_SERVICE_IDENTITY_SERVICE_CLIENT_ID=<heka-sso-service M2M client id>
# SSO_SERVICE_IDENTITY_SERVICE_CLIENT_SECRET=<heka-sso-service M2M client secret>
# SSO_SERVICE_IDENTITY_SERVICE_TOKEN_PARAMS={"audience":"https://heka-identity"}
# SSO_SERVICE_OIDC_ISSUER_URL=https://<ngrok host for 3005>

# VITE_SSO_WEBUI_AUTH_PROVIDER=auth0
# VITE_SSO_WEBUI_AUTH0_DOMAIN=<tenant>.<region>.auth0.com
# VITE_SSO_WEBUI_AUTH0_CLIENT_ID=<heka-sso-web-ui SPA client id>
# VITE_SSO_WEBUI_AUTH0_CONNECTION=heka-sso
