MEDIATOR_PUBLIC_DID=did:web:mediator.dev.paradym.id
ENABLE_KEPLR_INTEGRATION=false
ENABLE_EXTERNAL_AUTH=false
ENABLE_WALLET_BACKUP=false
ENABLE_EXAMPLE_CREDENTIAL=false
ENABLE_PUBLIC_INVITATION=false
CERTIFICATE_HASH=<base64url-encoded-sha256_cert_fingerprints>
WALLET_PROVIDER_URL=<wallet-provider-url>
# Static X.509 trust anchors (base64 DER, comma-separated; PEM accepted). Empty = trust only the anchors
# the configured trust sources publish. Never put the identity service's dev mDL issuer cert in a real build.
# TRUSTED_MDOC_ISSUER_CERTIFICATES=
# TRUSTED_REQUEST_SIGNER_CERTIFICATES=
