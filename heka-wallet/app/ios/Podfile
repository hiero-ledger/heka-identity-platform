source 'https://cdn.cocoapods.org'
require_relative '../../node_modules/react-native/scripts/react_native_pods'
require_relative '../../node_modules/react-native-permissions/scripts/setup'

# prevents location usage from react-native-vision-camera
$VCEnableLocation = false

# From RNP docs here: https://www.npmjs.com/package/react-native-permissions/v/4.0.1
def node_require(script)
  # Resolve script with node to allow for hoisting
  require `node -p "require.resolve('#{script}', {paths: [process.argv[1]]})" #{__dir__}`.strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# Expo modules autolinking for CocoaPods
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

platform :ios, '16.0'
prepare_react_native_project!

# React Native Firebase needs frameworks. v25 (old architecture) uses CocoaPods Firebase and
# supports static linkage via $RNFirebaseAsStaticFramework; v27+ needs SPM and dynamic linkage.
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym
$RNFirebaseAsStaticFramework = (linkage == 'static')

# Pods that do not build as frameworks stay static libraries, as before use_frameworks!:
# - anoncreds, indy-vdr: the pod framework would shadow the vendored native Anoncreds.framework /
#   indy_vdr.framework of the same name, and their .mm sources include cpp/ headers without a header map
# - react-native-user-identity: its npm package ships ios/DerivedData with duplicate generated headers
# - react-native-orientation-locker: imported by HekaWallet-Bridging-Header.h by its pod name
STATIC_LIBRARY_PODS = %w[anoncreds indy-vdr react-native-user-identity react-native-orientation-locker].freeze

pre_install do |installer|
  # A renamed or removed pod would silently fall back to a framework and break the build again
  unknown_pods = STATIC_LIBRARY_PODS - installer.pod_targets.map(&:name)
  raise Pod::Informative, "STATIC_LIBRARY_PODS lists unknown pods: #{unknown_pods.join(', ')}" unless unknown_pods.empty?

  installer.pod_targets.each do |pod|
    next unless STATIC_LIBRARY_PODS.include?(pod.name)

    def pod.build_type
      Pod::BuildType.static_library
    end
  end
end

target 'HekaWallet' do
  use_expo_modules!
  config = use_native_modules!

  setup_permissions([
    'Camera',
    'Notifications'
  ])


  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|

    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            # Newer Xcode only supports deployment targets >= 15.0; bump legacy pods
            # (SDWebImage 9.0, RNSVG 12.4, ...) to the app's minimum.
            if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 16.0
                config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
            end
            if target.name == 'RNArgon2'
                config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
                config.build_settings['SWIFT_ENABLE_INCREMENTAL_COMPILATION'] = 'NO'
                config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
            end
        end
    end

      # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
      react_native_post_install(
        installer,
        config[:reactNativePath],
        :mac_catalyst_enabled => false
      )

      # fmt 11.0.2 (bundled with RN 0.81) fails to compile with newer Apple
      # clang ("call to consteval function ... is not a constant expression").
      # Building it as C++17 makes fmt disable consteval. Must run after
      # react_native_post_install, which forces c++20 on all pods.
      installer.pods_project.targets.each do |target|
        next unless target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end

    end
end
