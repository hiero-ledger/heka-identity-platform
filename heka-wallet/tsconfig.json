{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ESNext"],
    "allowJs": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "removeComments": false,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@bifold/core/src/*": ["node_modules/@bifold/core/lib/typescript/src/*"],
      "@react-navigation/bottom-tabs/src/*": ["node_modules/@react-navigation/bottom-tabs/lib/typescript/src/*"]
    }
  },
  "exclude": ["node_modules", "eslint.config.mjs"]
}
