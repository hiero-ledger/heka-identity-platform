    "@hiero-did-sdk/client": "^0.1.8",
    "@hyperledger/anoncreds-nodejs": "0.4.0",
    "@hyperledger/anoncreds-shared": "0.4.0",
    "@hyperledger/indy-vdr-nodejs": "0.3.0",
    "@hyperledger/indy-vdr-shared": "0.3.0",
