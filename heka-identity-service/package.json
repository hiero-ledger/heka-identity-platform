{
  "name": "heka-identity-service",
  "version": "2.3.0",
  "license": "Apache-2.0",
  "description": "Reference implementation of identity service supporting Hiero Identity",
  "author": "DSR Corporation",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node --files -r tsconfig-paths/register -r @openwallet-foundation/askar-nodejs src/main.ts",
    "watch": "nodemon --config nodemon.json",
    "debug": "nodemon --config nodemon-debug.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run src/",
    "test:e2e": "vitest run test/",
    "check-types": "yarn check-types:src && yarn check-types:test",
    "check-types:src": "tsc -p tsconfig.src.json --noEmit",
    "check-types:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --fix",
    "lint-check": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "migration:create": "npx mikro-orm migration:create",
    "migration:up": "npx mikro-orm migration:up",
    "migration:down": "npx mikro-orm migration:down",
    "migration:list": "npx mikro-orm migration:list",
    "migration:pending": "npx mikro-orm migration:pending",
    "migration:fresh": "npx mikro-orm migration:fresh",
    "schema:drop": "npx mikro-orm schema:drop",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": "^22.17.0"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "0.7.0",
    "@credo-ts/askar": "0.7.0",
