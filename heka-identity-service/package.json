    "nestjs-pino": "^3.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^8.14.1",
    "pino-http": "^8.3.3",
    "pino-pretty": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^4.6.2",
    "typescript": "~5.9.3",
    "uuid": "^9.0.0",
    "ws": "^8.13.0",
