    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "@types/multer": "^1.4.11",
    "async-mutex": "^0.5.0",
    "axios": "^1.17.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "colorette": "^2.0.20",
