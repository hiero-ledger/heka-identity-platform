{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GithubContributorCredentialClaims",
  "type": "object",
  "properties": {
    "githubAccountId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "githubUsername": {
      "type": "string",
      "minLength": 1
    },
    "gpgFingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{16,40}$"
    },
    "verifiedAt": {
      "type": "string"
    },
    "walletId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["githubAccountId", "githubUsername", "gpgFingerprint", "verifiedAt", "walletId"],
  "additionalProperties": false
}
