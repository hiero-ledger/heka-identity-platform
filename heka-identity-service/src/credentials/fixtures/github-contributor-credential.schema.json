{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GithubContributorCredentialClaims",
  "type": "object",
  "properties": {
    "githubUsername": {
      "type": "string",
      "minLength": 1
    },
    "githubAccountId": {
      "type": "integer",
      "minimum": 1
    },
    "gpgFingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{16,40}$"
    }
  },
  "required": ["githubUsername", "githubAccountId", "gpgFingerprint"],
  "additionalProperties": false
}