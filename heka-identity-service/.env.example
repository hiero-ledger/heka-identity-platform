IMAGE="heka-identity-service:latest"

FILE_STORAGE_FS_URL=http://localhost:3000
FILE_STORAGE_FS_PUBLIC_URL=<heka identity service URL, e.g. https://abc123.ngrok-free.app>

AGENT_OID4VCI_ENDPOINT=<heka identity service URL, e.g. https://abc123.ngrok-free.app>
AGENT_HTTP_ENDPOINT=<heka identity service URL, e.g. https://abc123.ngrok-free.app>
AGENT_WS_ENDPOINT=<heka identity service URL, e.g. ws://abc123.ngrok-free.app>

# Keycloak
# Inside Docker (docker-compose.yml) the service reaches a host Keycloak through
# host.docker.internal, not localhost: keep the issuer browser-facing and set the
# server-to-server URLs (OIDC_JWKS_URI, DEMO_TOKEN_URL) to http://host.docker.internal:8080/...
# or leave them unset to get those defaults from the compose file. On Docker Desktop
# host.docker.internal also resolves on the host, so one value serves yarn start too.
OIDC_ISSUER_URL=<keycloak url, e.g. http://localhost:8080>/realms/heka-platform
OIDC_AUDIENCE=heka-identity-service

# Auth0
# OIDC_ISSUER_URL=https://<tenant>.<region>.auth0.com/
# OIDC_AUDIENCE=https://heka-identity
# OIDC_CLAIM_USER_ID=https://heka/heka_uid
# OIDC_CLAIM_ROLES=https://heka/roles
# OIDC_CLAIM_NAME=https://heka/name,name,nickname
# OIDC_CLAIM_ORG_ID=https://heka/org_id

# Keycloak for demo flows
# DEMO_TOKEN_URL=<keycloak url, e.g. http://localhost:8080>/realms/heka-platform/protocol/openid-connect/token
# DEMO_CLIENT_ID=heka-demo
# DEMO_CLIENT_SECRET=dev-only-heka-demo-secret-do-not-use-in-production
# DEMO_CLIENT_AUTH_METHOD=client_secret_post
# DEMO_TOKEN_PARAMS=
# DEMO_TOKEN_RATE_LIMIT=30

# Auth0 for demo flows
# DEMO_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# DEMO_CLIENT_ID=<client ID, e.g. Ab12Cd34Ef56Gh78Ij90Kl12Mn34Op56>
# DEMO_CLIENT_SECRET=<client secret>
# DEMO_TOKEN_PARAMS={"audience":"https://heka-identity"}
