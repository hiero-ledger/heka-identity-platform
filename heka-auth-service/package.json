{
  "name": "heka-auth-service",
  "version": "0.0.1",
  "description": "Heka Auth service",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npx @nestjs/cli build",
    "check-types": "yarn check-types:src && yarn check-types:test",
    "check-types:src": "tsc --noEmit",
    "check-types:test": "tsc -p tsconfig.test.json --noEmit",
    "start": "npx @nestjs/cli start",
    "start:dev": "npx @nestjs/cli start --watch",
    "start:debug": "npx @nestjs/cli start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint-check": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "orm": "npx mikro-orm",
    "migration:create": "npx mikro-orm migration:create",
    "migration:up": "npx mikro-orm migration:up",
    "migration:down": "npx mikro-orm migration:down",
    "migration:list": "npx mikro-orm migration:list",
    "migration:pending": "npx mikro-orm migration:pending",
    "migration:fresh": "npx mikro-orm migration:fresh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^22.17.0"
  },
  "dependencies": {
    "@eropple/nestjs-correlation-id": "^1.0.1",
    "@mikro-orm/core": "^7.1.3",
    "@mikro-orm/decorators": "^7.1.3",
    "@mikro-orm/migrations": "^7.1.3",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.3",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "generate-password": "^1.7.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^8.19.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.3",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.2",
    "@types/passport": "^1.0.16",
    "@types/passport-http": "^0.3.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "multer": "^2.2.0",
    "js-yaml": "^4.2.0",
    "vite": "^6.4.3"
  },
  "mikro-orm": {
    "tsLoader": "tsx",
    "configPaths": [
      "./src/core/database/database.options.cli.ts",
      "./dist/core/database/database.options.cli.js"
    ]
  },
  "packageManager": "yarn@4.16.0"
}
