{
  "compilerOptions": {
    // MikroORM v7 ships ESM-only packages whose type declarations reference
    // subpath exports (e.g. `@mikro-orm/core/schema`). Resolving those requires
    // an exports-map-aware moduleResolution, so the project uses nodenext.
    // Emit stays CommonJS (package.json has no "type": "module").
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "noImplicitAny": true,
    "removeComments": true,
    "noLib": false,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es6",
    "sourceMap": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "paths": {
      "@core/*": ["src/core/*"],
      "@common/*": ["src/common/*"],
      "@config": ["src/core/config"],
      "@utils": ["src/common/utils"],
      "@const": ["src/common/const"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
